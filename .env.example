# Recommended locally and required in production. Never reuse the production value.
PAYLOAD_SECRET=

# Optional independent secrets. Each falls back as documented in docs/HANDOVER.md.
PAYLOAD_PREVIEW_SECRET=
OFFICIAL_SNAPSHOT_REFRESH_TOKEN=

# Product-side Invite synchronization. The public waitlist UI is currently disabled.
OFFICIAL_WAITLIST_SYNC_TOKEN=
NOUMI_PRODUCT_API_URL=https://www.noumi.ai

# Browser analytics. POSTHOG_PROJECT_KEY is browser-visible, not a private API key.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_BROWSER_API_HOST=https://e.noumi.ai
POSTHOG_UI_HOST=https://us.posthog.com

# Local Payload behavior. Keep autosave/live preview off unless they are needed.
PAYLOAD_ENABLE_DEV_AUTOSAVE=false
PAYLOAD_ENABLE_DEV_LIVE_PREVIEW=false
PAYLOAD_LOG_LEVEL=info

# Local overrides for the published-content and snapshot layers.
OFFICIAL_CMS_REVALIDATE_SECONDS=300
OFFICIAL_SNAPSHOT_R2_PREFIX=official-site-snapshots
OFFICIAL_SNAPSHOT_REFRESH_SECONDS=7200
OFFICIAL_SNAPSHOT_REFRESH_ORIGIN=https://noumi.ai
