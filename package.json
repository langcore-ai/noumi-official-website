{
  "name": "noumi-official-website",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "scripts": {
    "help": "bun tooling/infra/help.ts",
    "infra:doctor": "bun tooling/infra/cli.ts doctor",
    "infra:setup": "bun tooling/infra/cli.ts setup",
    "mode:local": "bun tooling/infra/mode.ts local",
    "mode:preview": "bun tooling/infra/mode.ts preview",
    "mode:reload": "bun tooling/infra/mode.ts reload",
    "mode:status": "bun tooling/infra/mode.ts status",
    "mode:stop": "bun tooling/infra/mode.ts stop",
    "release": "bun tooling/release/cli.ts",
    "prebuild": "node ./scripts/patch-opennext-env-shim.mjs && node ./scripts/patch-opennext-local-bindings.mjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:cloudflare": "bun run prebuild && opennextjs-cloudflare build",
    "check:fast": "prettier --check package.json tooling && eslint . && tsc --noEmit && bun run test:int && bun run build",
    "check:full": "bun run check:fast && bun run test:e2e && bun run build:cloudflare",
    "deploy": "bun run deploy:database && bun run deploy:app",
    "deploy:app": "bun run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "bun run generate:types:cloudflare && bun run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "bun install --frozen-lockfile",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "cross-env OPEN_NEXT_LOCAL_BINDINGS=true bun run build:cloudflare && cross-env OPEN_NEXT_LOCAL_BINDINGS=true opennextjs-cloudflare preview --local",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "bun run test:int && bun run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@opennextjs/cloudflare": "^1.11.0",
    "@payloadcms/db-d1-sqlite": "^3.81.0",
    "@payloadcms/live-preview-react": "3.81.0",
    "@payloadcms/next": "^3.81.0",
    "@payloadcms/plugin-redirects": "^3.81.0",
    "@payloadcms/plugin-seo": "^3.81.0",
    "@payloadcms/richtext-lexical": "^3.81.0",
    "@payloadcms/storage-r2": "^3.81.0",
    "@payloadcms/ui": "^3.81.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jose": "^5.10.0",
    "next": "15.4.11",
    "payload": "^3.81.0",
    "posthog-js": "^1.372.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "28.0.0",
    "parse5": "8.0.0",
    "picocolors": "^1.1.1",
    "postcss": "8.4.31",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "^4.80.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
